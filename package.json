{
  "name": "syntaxdiff",
  "private": false,
  "version": "1.5.8",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "description": "Privacy-first, client-side syntax-aware diff tool (JSON, YAML, SQL, TOML, XML). Diffs structure, not bytes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimasbaguspm/syntaxdiff.git"
  },
  "bugs": {
    "url": "https://github.com/dimasbaguspm/syntaxdiff/issues"
  },
  "homepage": "https://syntaxdiff.dimasbaguspm.dev",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt src vite.config.ts vitest.config.ts",
    "fmt:check": "oxfmt --check src vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "semantic-release"
  },
  "dependencies": {
    "@material-symbols/svg-400": "0.46.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-zone": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-fetch": "0.221.0",
    "@opentelemetry/instrumentation-user-interaction": "0.65.0",
    "@opentelemetry/instrumentation-xml-http-request": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@tailwindcss/vite": "4.3.3",
    "clsx": "2.1.1",
    "dexie": "4.4.5",
    "diff": "8.0.4",
    "fast-xml-parser": "5.10.1",
    "js-yaml": "4.3.1",
    "lucide-react": "1.31.0",
    "marked": "18.0.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "smol-toml": "1.8.0",
    "sql-formatter": "15.8.2",
    "tailwindcss": "4.3.3",
    "ua-parser-js": "2.0.10",
    "workbox-window": "7.4.1",
    "zustand": "5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@htnabe/prettier-plugin-go-template": "0.0.3",
    "@material-symbols/svg-400": "0.46.0",
    "@poliklot/prettier-plugin-handlebars": "0.4.0",
    "@prettier/plugin-php": "0.25.0",
    "@prettier/plugin-pug": "3.4.2",
    "@prettier/plugin-xml": "3.4.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "conventional-changelog-conventionalcommits": "10.3.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.11.6",
    "jsdom": "30.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-gherkin": "4.0.0",
