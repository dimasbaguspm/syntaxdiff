{
  "name": "syntaxdiff",
  "private": false,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "description": "Privacy-first, client-side syntax-aware diff tool (JSON, YAML, SQL, TOML, XML). Diffs structure, not bytes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimasbaguspm/syntaxdiff.git"
  },
  "bugs": {
    "url": "https://github.com/dimasbaguspm/syntaxdiff/issues"
  },
  "homepage": "https://syntaxdiff.dimasbaguspm.dev",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt src vite.config.ts vitest.config.ts",
    "fmt:check": "oxfmt --check src vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "semantic-release"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-fetch": "^0.221.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.65.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "diff": "^8.0.2",
    "fast-xml-parser": "^5.2.5",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.4",
    "smol-toml": "^1.4.0",
    "sql-formatter": "^15.6.2",
    "tailwindcss": "^4.3.3",
    "ua-parser-js": "^2.0.10",
    "zustand": "^5.0.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.75.0",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
